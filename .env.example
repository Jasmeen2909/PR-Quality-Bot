# Shared secret the calling GitHub Actions workflow sends as a Bearer token; generate your own, never reuse this value.
SERVICE_AUTH_TOKEN=your_service_auth_token_here
# Claude API key used for all LLM calls in lib/llm/.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Which Claude model to call; defaults to Haiku for cost since this runs on every PR push (see architecture.md §1).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Postgres connection string used by Prisma.
DATABASE_URL=your_database_url_here